# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@localhost:5432/<database_name>
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/ai_smart_classroom

# Authentication (use a secure random string in production)
JWT_SECRET_KEY=your_jwt_secret_key_change_me_in_production

# Camera & AI Model Settings
CAMERA_INDEX=0
CAMERA_SOURCE=0
YOLO_MODEL=yolov8m.pt
ATTENDANCE_THRESHOLD=0.70
ATTENTION_THRESHOLD=0.60
FACE_RECOGNITION_THRESHOLD=0.50

# Temporal Stability (samples and duration required for stable behavior)
ATTENTION_MINIMUM_SAMPLES=3
ATTENTION_MINIMUM_DURATION_SECONDS=4.0
